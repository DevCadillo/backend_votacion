# Flask
SECRET_KEY=genera-una-clave-larga-y-aleatoria
FLASK_ENV=production
SESSION_COOKIE_SECURE=true

# Supabase PostgreSQL: usa Connect > Session pooler (puerto 5432) para Render
DATABASE_URL=postgresql://postgres.PROJECT_REF:TU_PASSWORD@HOST_POOLER:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Supabase Storage (para nuevas fotos de candidatos)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=candidatos
